# newapi_exporter 配置文件示例
# 配置优先级: 默认值 < 配置文件 < 环境变量 < CLI 参数

# 数据库类型: sqlite 或 mysql
db_type: sqlite

# SQLite 数据库文件路径 (db_type=sqlite 时使用)
database_path: newapi.db

# MySQL 连接配置 (db_type=mysql 时使用)
# mysql_host: localhost
# mysql_port: "3306"
# mysql_user: root
# mysql_password: ""
# mysql_database: newapi

# 输出格式: json 或 csv
output_format: json
